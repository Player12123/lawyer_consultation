# Copy this file to .env.local for local development, or to the deployment
# environment file used by systemd/cloud secret manager. Do not commit real
# credentials or long-lived production secrets.

# Core runtime
APP_ENV=production
API_PORT=8788
APP_ORIGIN=https://your-production-domain.example.com
COOKIE_SECURE=true
NEXT_PUBLIC_API_BASE_URL=

# Database and tenant
DATABASE_URL=mysql://pocketlegal_app:REPLACE_PASSWORD@MYSQL_PRIVATE_HOST:3306/pocket_legal_assistant
TENANT_ID=REPLACE_26_CHARACTER_TENANT_ID

# Security keys
SESSION_TOKEN_PEPPER=REPLACE_32_BYTE_OR_LONGER_RANDOM_VALUE
PHONE_HASH_PEPPER=REPLACE_32_BYTE_OR_LONGER_RANDOM_VALUE
VERIFICATION_CODE_PEPPER=REPLACE_32_BYTE_OR_LONGER_RANDOM_VALUE
CONSULTATION_CONTENT_KEY=REPLACE_32_BYTE_OR_LONGER_RANDOM_VALUE
SESSION_IDLE_MINUTES=10
PHONE_CHANGE_PROOF_MINUTES=10

# SMS provider
SMS_PROVIDER=bestone
SMS_BESTONE_ENDPOINT=REPLACE_HTTPS_OR_PRIVATE_ENDPOINT
SMS_BESTONE_APP_ID=REPLACE_ME
SMS_BESTONE_PASSWORD=REPLACE_ME
SMS_ALLOW_INSECURE_ENDPOINT=false

# Optional Tencent SMS provider
SMS_TENCENT_SECRET_ID=REPLACE_ME
SMS_TENCENT_SECRET_KEY=REPLACE_ME
SMS_TENCENT_SDK_APP_ID=REPLACE_ME
SMS_TENCENT_SIGN_NAME=REPLACE_ME
SMS_TENCENT_TEMPLATE_ID=REPLACE_ME
SMS_TENCENT_REGION=ap-guangzhou

# AI provider
AI_BASE_URL=REPLACE_HTTPS_BASE_URL
AI_API_KEY=REPLACE_ME
AI_MODEL=REPLACE_ME
AI_THINKING_TYPE=disabled
AI_TEMPERATURE=0.35
AI_TIMEOUT_MS=45000

# Legal tools provider. The law and case endpoints share one x-app credential.
LEGAL_TOOLS_X_APP_ID=REPLACE_ME
LEGAL_TOOLS_X_APP_SECRET=REPLACE_ME
LAW_SEARCH_ENDPOINT=REPLACE_HTTPS_ENDPOINT
CASE_SEARCH_ENDPOINT=REPLACE_HTTPS_ENDPOINT
LAW_SEARCH_TIMEOUT_MS=4000
CASE_SEARCH_TIMEOUT_MS=5000

# Retention
CONSULTATION_CONTENT_RETENTION_DAYS=365
INTERNAL_ERROR_LOG_RETENTION_DAYS=200

# Local diagnostics only
ENV_FILE=.env.local
SMOKE_BASE_URL=http://localhost:3000
AB_ENTRY_ID=
