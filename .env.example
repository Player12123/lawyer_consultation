# 复制为 .env.local 后，只填写你从服务方获得的账号、密钥或接口地址。
# 真实值只放在 .env.local，绝不提交。

# 本机数据库与系统安全密钥
DATABASE_URL=mysql://root@127.0.0.1:3306/pocket_legal_assistant
TENANT_ID=REPLACE_ME
SESSION_TOKEN_PEPPER=REPLACE_ME
PHONE_HASH_PEPPER=REPLACE_ME
VERIFICATION_CODE_PEPPER=REPLACE_ME
CONSULTATION_CONTENT_KEY=REPLACE_ME

# 短信服务方提供的信息
SMS_BESTONE_ENDPOINT=http://smsswitch.b114.com.cn/sendMsgNew
SMS_BESTONE_APP_ID=REPLACE_ME
SMS_BESTONE_PASSWORD=REPLACE_ME

# AI 服务方提供的信息
AI_BASE_URL=https://aichat.bestone.com/kdlsnt/v3
AI_API_KEY=REPLACE_ME
AI_MODEL=bstaichat-V101

# 法条与类案服务方提供的信息（两项接口共用同一组 x-app 凭据）
LEGAL_TOOLS_X_APP_ID=REPLACE_ME
LEGAL_TOOLS_X_APP_SECRET=REPLACE_ME
LAW_SEARCH_ENDPOINT=https://openapi.bestone.com/fatiaomatch/lawmatch/laws/match
CASE_SEARCH_ENDPOINT=https://openapi.bestone.com/caseanswer/api/v2/precise_search
