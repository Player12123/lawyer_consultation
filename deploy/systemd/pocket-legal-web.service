[Unit]
Description=12348 Legal Assistant Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pocketlegal
Group=pocketlegal
WorkingDirectory=/opt/pocket-legal-assistant
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pocket-legal-assistant

[Install]
WantedBy=multi-user.target
